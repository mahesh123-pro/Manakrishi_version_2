# Manakrishi — Booking backend configuration
# Copy this file to `.env.local` and fill in the values.
# These are the SAME projects the current live site uses, so bookings keep
# flowing into the existing Firestore + WhatsApp automator + Google Sheet.
#
# NOTE: Firebase web config values are public by design (they ship to the
# browser). Security comes from Firestore Rules, not from hiding these keys.
# Recommended rule: allow `create` on the `bookings` collection only.

# --- Primary: Firestore (project: manakrishi-booking) ---
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=manakrishi-booking.firebaseapp.com
NEXT_PUBLIC_FB_PROJECT_ID=manakrishi-booking
NEXT_PUBLIC_FB_STORAGE_BUCKET=manakrishi-booking.firebasestorage.app
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=658175860538
NEXT_PUBLIC_FB_APP_ID=
NEXT_PUBLIC_FB_MEASUREMENT_ID=G-246CVYV263

# --- Secondary: Realtime Database (project: db-vt-gsocp) — feeds WhatsApp Automator ---
NEXT_PUBLIC_RTDB_API_KEY=
NEXT_PUBLIC_RTDB_AUTH_DOMAIN=db-vt-gsocp.firebaseapp.com
NEXT_PUBLIC_RTDB_DATABASE_URL=https://db-vt-gsocp-default-rtdb.firebaseio.com
NEXT_PUBLIC_RTDB_PROJECT_ID=db-vt-gsocp
NEXT_PUBLIC_RTDB_APP_ID=

# --- Google Apps Script endpoint (appends a row to the bookings Sheet) ---
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# --- Razorpay (server-only; never prefix the secret with NEXT_PUBLIC_) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional fixed advance in paise: set your approved amount (100 paise = INR 1).
# Blank disables checkout while allowing booking requests.
RAZORPAY_BOOKING_ADVANCE_PAISE=

# Marketplace: server-only pooled Postgres URL. Required on Vercel.
DATABASE_URL=
# Optional direct URL for schema migration (never NEXT_PUBLIC_).
MARKETPLACE_MIGRATION_DATABASE_URL=
# Offline SQLite development only; optional persistent-disk hosting fallback.
MARKETPLACE_DATA_DIR=
# Optional canonical origin behind a reverse proxy, e.g. https://manakrishi.in
MARKETPLACE_ORIGIN=

# Admin service-booking workspace: primary Firebase project only.
# Server-only service-account JSON. Never use a NEXT_PUBLIC_ prefix.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_BOOKINGS_PROJECT_ID=manakrishi-booking
